# Zachary Panel Agent 配置文件
# 复制为 agent.yaml 并修改

# Server 地址（必填）
server_url: "https://your-server.com"

# 节点 ID（在 Server 面板创建节点时获得，必填）
node_id: "node_xxxxxxxxxxxx"

# Install Token（一次性，注册时使用）
# 注册成功后会保存为 node_token 文件
install_token: "it_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# WebSocket 路径
ws_path: "/ws/agent"

# 心跳间隔（秒）
heartbeat_interval: 30

# 重连基础延迟（秒），指数退避
reconnect_base_delay: 2

# 重连最大延迟（秒）
reconnect_max_delay: 60

# TLS 证书验证（生产环境建议 true）
tls_verify: true

# nftables 路径
nft_path: "/usr/sbin/nft"

# gost 路径
gost_path: "/usr/local/bin/gost"

# 日志级别: trace, debug, info, warn, error
log_level: "info"

# 日志文件（可选，默认输出到 stdout）
# log_file: "/var/log/zachary-agent.log"
