# Panel 配置
PANEL_URL=http://your-domain.com:8080
GRPC_URL=your-domain.com:9090
LOG_LEVEL=info

# 数据库配置
DB_PATH=/data/panel.db

# 开发/生产环境
ENV=prod

# SSL 配置
SSL_CERT=/etc/nginx/ssl/server.crt
SSL_KEY=/etc/nginx/ssl/server.key

# 安全配置
CORS_ORIGIN=*
JWT_SECRET=your-jwt-secret-key-here

# 日志配置
LOG_FILE=/var/log/zachary-panel/app.log
LOG_MAX_SIZE=100
LOG_MAX_BACKUPS=10
LOG_MAX_AGE=30