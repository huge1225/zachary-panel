# ─── Stage 1: Build frontend ───
FROM node:20-slim AS frontend-builder
WORKDIR /app/frontend
COPY frontend/package*.json ./
RUN npm ci --silent 2>/dev/null || npm install --silent
COPY frontend/ ./
RUN npm run build

# ─── Stage 2: Build Rust server binary ───
FROM rust:1-bookworm AS builder
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Cache dependencies
COPY Cargo.toml Cargo.lock ./
COPY crates/common/Cargo.toml crates/common/
COPY crates/core/Cargo.toml crates/core/
COPY crates/server/Cargo.toml crates/server/
COPY crates/agent/Cargo.toml crates/agent/
COPY crates/migration/Cargo.toml crates/migration/

RUN mkdir -p crates/common/src && echo "" > crates/common/src/lib.rs \
    && mkdir -p crates/core/src && echo "" > crates/core/src/lib.rs \
    && mkdir -p crates/server/src && echo "" > crates/server/src/lib.rs \
    && mkdir -p crates/agent/src && echo "fn main(){}" > crates/agent/src/main.rs \
    && mkdir -p crates/migration/src && echo "" > crates/migration/src/lib.rs \
    && cargo build --release 2>/dev/null || true

# Build real code
COPY . .
RUN touch crates/common/src/lib.rs crates/core/src/lib.rs \
      crates/server/src/lib.rs crates/agent/src/main.rs crates/migration/src/lib.rs \
    && cargo build --release --bin zachary-panel-server

# ─── Stage 3: Server runtime image ───
FROM debian:bookworm-slim AS server

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates nftables curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy server binary from Rust builder
COPY --from=builder /app/target/release/zachary-panel-server /app/zachary-panel-server

# Copy frontend dist from frontend builder
COPY --from=frontend-builder /app/frontend/dist /app/frontend/dist

# Copy deploy scripts (install-agent.sh etc.)
COPY deploy/ /app/deploy/

# Data directory
RUN mkdir -p /app/data

ENV DATABASE_URL=sqlite:///app/data/zachary-panel.db?mode=rwc
ENV HOST=0.0.0.0
ENV PORT=38088
ENV RUST_LOG=info

EXPOSE 38088

ENTRYPOINT ["/app/zachary-panel-server"]
