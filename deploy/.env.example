# Zachary Panel Docker Compose 环境变量示例
# 可通过根目录 ./install.sh 交互式向导自动生成 deploy/.env（权限 0600）

# 宿主机监听地址与端口（配合 Nginx/Caddy 反代建议保持 127.0.0.1；直接通过 IP:端口 访问可改为 0.0.0.0）
NEXUS_BIND_HOST=127.0.0.1
NEXUS_PORT=8080

# 面板对外访问 URL（用于生成被控节点一键对接命令，生产环境请填 https://你的域名）
NEXUS_PUBLIC_URL=https://panel.example.com

# 数据库配置（sqlite | postgres | mysql）
NEXUS_DB_DRIVER=sqlite
NEXUS_DB_DSN=/data/nexus_panel.db

# 初始管理员邮箱与密码（密码留空时首次启动自动生成随机密码并输出到容器日志）
NEXUS_ADMIN_EMAIL=admin@example.com
NEXUS_ADMIN_PASSWORD=

# 反向代理受信任网段（逗号分隔 IP/CIDR）
NEXUS_TRUSTED_PROXIES=172.16.0.0/12,127.0.0.1/32

# 安全与演示选项
NEXUS_ALLOW_PRIVATE_TARGETS=false
NEXUS_SEED_DEMO=false
