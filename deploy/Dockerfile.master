# Stage 1: Build Frontend
FROM node:20-alpine AS web-builder
WORKDIR /build/web
COPY web/package.json ./
RUN npm install
COPY web/ ./
RUN npm run build

# Stage 2: Build Go Master & Agent Binaries
FROM golang:1.22-alpine AS go-builder
RUN apk add --no-cache gcc musl-dev sqlite-dev
WORKDIR /build
COPY go.mod ./
COPY cmd/ ./cmd/
COPY internal/ ./internal/
COPY pkg/ ./pkg/
RUN go mod tidy && \
    CGO_ENABLED=1 GOOS=linux go build -ldflags="-s -w" -o /out/nexus-master ./cmd/master && \
    CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -ldflags="-s -w" -o /out/nexus-agent-linux-amd64 ./cmd/agent && \
    CGO_ENABLED=0 GOOS=linux GOARCH=arm64 go build -ldflags="-s -w" -o /out/nexus-agent-linux-arm64 ./cmd/agent

# Stage 3: Final Runtime Image
FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata sqlite-libs
WORKDIR /app
COPY --from=go-builder /out/nexus-master /app/nexus-master
COPY --from=go-builder /out/nexus-agent-linux-amd64 /app/static/releases/nexus-agent-linux-amd64
COPY --from=go-builder /out/nexus-agent-linux-arm64 /app/static/releases/nexus-agent-linux-arm64
COPY --from=web-builder /build/web/dist /app/web/dist
COPY deploy/install-agent.sh /app/static/install-agent.sh

VOLUME ["/data"]
EXPOSE 8080

ENTRYPOINT ["/app/nexus-master"]
CMD ["-listen", ":8080", "-db", "/data/nexus_panel.db"]
