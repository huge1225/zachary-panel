[Unit]
Description=Zachary Panel Server
After=network.target

[Service]
Type=simple
User=zachary
Group=zachary
WorkingDirectory=/opt/zachary-panel
EnvironmentFile=/opt/zachary-panel/.env
ExecStart=/opt/zachary-panel/zachary-panel-server
Restart=always
RestartSec=5

# Security
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/zachary-panel/data

[Install]
WantedBy=multi-user.target
